{"M":[["alfred","Alfred the Great","871–899",0,"King of Wessex and, by the end, of the Anglo-Saxons. Grandson of Egbert."],["edelder","Edward the Elder","899–924",0,"Alfred's son. Three of his sons reigned in turn."],["athelstan","Æthelstan","924–939",0,"Never married and had no known children."],["edmund1","Edmund I","939–946",0,"Killed at 25, leaving two small sons who both reigned."],["eadred","Eadred","946–955",0,"Unmarried. Succeeded by his nephews."],["eadwig","Eadwig","955–959",0,"Died at about 19 without children."],["edgar","Edgar the Peaceful","959–975",0,"Father of two kings, Edward the Martyr and Æthelred."],["edmartyr","Edward the Martyr","975–978",0,"Murdered at Corfe as a teenager, unmarried."],["aethelred","Æthelred the Unready","978–1016",0,"Father of Edmund Ironside by his first marriage and Edward the Confessor by his second."],["sweyn","Sweyn Forkbeard","1013–1014",0,"King of Denmark who conquered England weeks before his death. His daughter Estrid founded the later Danish royal line."],["ironside","Edmund Ironside","1016",0,"Reigned seven months. His son Edward grew up in exile in Hungary, and Edward's daughter Margaret married the King of Scots."],["cnut","Cnut","1016–1035",0,"His sons left no heirs, and his daughter Gunhilda's only child became an abbess."],["harefoot","Harold Harefoot","1035–1040",0,"No established descendants."],["harthacnut","Harthacnut","1040–1042",0,"Died unmarried at about 24."],["confessor","Edward the Confessor","1042–1066",0,"Childless, which set off the succession crisis of 1066."],["harold2","Harold II","1066",0,"Killed at Hastings. His daughter Gytha fled east and married Vladimir Monomakh; their descendants married into the royal houses of Europe."],["william1","William I","1066–1087",1,"Duke of Normandy, descended from the Viking Rollo. His wife Matilda of Flanders was a descendant of Alfred, so their children were too."],["william2","William II","1087–1100",1,"Unmarried. Killed by an arrow in the New Forest."],["henry1","Henry I","1100–1135",1,"His only legitimate son drowned in the White Ship, leaving his daughter Matilda as heir."],["stephen","Stephen","1135–1154",1,"His sons died without heirs. His line continued through his daughter Marie of Boulogne into the house of Brabant."],["henry2","Henry II","1154–1189",2,"Son of Empress Matilda and first of the Plantagenets."],["richard1","Richard I","1189–1199",2,"No legitimate children. One illegitimate son, Philip of Cognac, has no known descendants."],["john","John","1199–1216",2,"Henry II's youngest son, and an ancestor of every monarch after him."],["henry3","Henry III","1216–1272",2,"King at nine. Reigned 56 years."],["edward1","Edward I","1272–1307",2,"Children by two marriages: Edward II by Eleanor of Castile, and the earls of Norfolk and Kent by Margaret of France."],["edward2","Edward II","1307–1327",2,"Deposed in 1327 in favour of his son."],["edward3","Edward III","1327–1377",2,"Five sons reached adulthood, and their rival lines fought the Wars of the Roses."],["richard2","Richard II","1377–1399",2,"Childless. Deposed by his cousin Henry IV."],["henry4","Henry IV","1399–1413",3,"His legitimate lines died out by 1471. A line through an illegitimate granddaughter, Antigone of Gloucester, probably survives."],["henry5","Henry V","1413–1422",3,"His only child was Henry VI."],["henry6","Henry VI","1422–1461, 1470–71",3,"His only son, Edward of Westminster, was killed at Tewkesbury in 1471."],["edward4","Edward IV","1461–70, 1471–83",3,"Father of Elizabeth of York and of the Princes in the Tower."],["edward5","Edward V","1483",3,"One of the Princes in the Tower. Disappeared at 12."],["richard3","Richard III","1483–1485",3,"His only legitimate son died in 1484."],["henry7","Henry VII","1485–1509",4,"Claimed the throne through his mother, Margaret Beaufort, and married Elizabeth of York."],["henry8","Henry VIII","1509–1547",4,"All three of his children reigned and all died childless."],["edward6","Edward VI","1547–1553",4,"Died unmarried at 15."],["mary1","Mary I","1553–1558",4,"Married Philip II of Spain. No children."],["elizabeth1","Elizabeth I","1558–1603",4,"Never married."],["james1","James I","1603–1625",5,"Already James VI of Scotland. Descended from Henry VII twice over, through both his parents."],["charles1","Charles I","1625–1649",5,"Executed in 1649. His descendants run through his daughter Henrietta Anne into the Catholic houses of Europe, and through his sons' illegitimate children into the British aristocracy."],["charles2","Charles II","1660–1685",5,"No legitimate children, but at least a dozen acknowledged illegitimate ones, ancestors of several ducal families and of Diana, Princess of Wales."],["james2","James II","1685–1688",5,"His legitimate line ended in 1807 with Henry, Cardinal York. Descendants survive through his illegitimate children by Arabella Churchill."],["william3","William III","1689–1702",5,"No children. Son of Charles I's daughter Mary."],["mary2","Mary II","1689–1694",5,"No children. Reigned jointly with her husband and cousin William."],["anne","Anne","1702–1714",5,"Seventeen pregnancies and no child who outlived her."],["george1","George I","1714–1727",6,"Son of Sophia of Hanover. More than fifty closer relatives were passed over for being Catholic."],["george2","George II","1727–1760",6,"Outlived his son Frederick, so the crown went to his grandson."],["george3","George III","1760–1820",6,"Fifteen children, yet by 1817 no legitimate grandchild."],["george4","George IV","1820–1830",6,"His only legitimate child, Princess Charlotte, died in childbirth in 1817."],["william4","William IV","1830–1837",6,"Ten illegitimate children with the actress Dorothea Jordan. No legitimate child survived infancy."],["victoria","Victoria","1837–1901",6,"Nine children, who married across the royal houses of Europe."],["edward7","Edward VII","1901–1910",7,"Victoria's eldest son."],["george5","George V","1910–1936",7,"Father of two kings."],["edward8","Edward VIII","